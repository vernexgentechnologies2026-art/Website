# ---------------------------------------------------------------------------
# Vernex website — public configuration
#
# Every VITE_* variable is embedded into the JavaScript bundle and is visible
# to anyone who opens the site. Put ONLY public configuration here.
# NEVER put API secrets, tokens or private keys in a VITE_* variable.
#
# Copy this file to `.env.local` (git-ignored) for local development, and set
# the same variables in your hosting provider for production builds.
# ---------------------------------------------------------------------------

# Base URL of the Vernex backend API, without a trailing slash.
# Leave empty until the backend exists: the booking flow then runs in clearly
# labelled DEMO mode and nothing is sent anywhere.
# Example: https://api.vernexgentech.in
VITE_API_BASE_URL=

# WhatsApp number in international format, digits only (country code, no + or spaces).
# Used for the floating WhatsApp button and prefilled enquiry links.
# Example: 919876543210
VITE_WHATSAPP_PHONE=

# Phone number for the "Call us" buttons, in E.164 format.
# Example: +919876543210
VITE_CONTACT_PHONE=

# Public contact email shown in the footer.
VITE_CONTACT_EMAIL=
